# Supabase (sinkronisasi cloud + login)
# Ambil dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Server-only: jangan gunakan prefix NEXT_PUBLIC_ dan jangan masukkan ke client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Mayar: sandbox gunakan https://api.mayar.io/hl/v2, production https://api.mayar.id/hl/v2
MAYAR_API_KEY=your_mayar_read_write_api_key
MAYAR_API_BASE_URL=https://api.mayar.io/hl/v2
COACH_PRICE_IDR=
APP_BASE_URL=https://gym.abadikan.com

# Mixpanel (konfigurasikan hanya pada deployment production)
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_project_token
NEXT_PUBLIC_APP_ENV=production
