# Ganti gym.example.com dengan domain/subdomain kamu, lalu:
# A record domain -> IP VPS, dan jalankan `docker compose up -d --build`.
# Caddy otomatis mengurus HTTPS (Let's Encrypt) — syarat PWA bisa di-install.
gym.abadikan.com {
	reverse_proxy app:3000
}
# Domain/Subdomain untuk Project Ayu
ayuadina.abadikan.com {
